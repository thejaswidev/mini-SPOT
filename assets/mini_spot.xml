<!--
  Mujoco Mini Spot implementation

  TODO:
  - Add additional / replace / modify inertial masses and inertia tensors based on CAD files
    Example:
      <inertial mass="0.696" pos="-0.003311 -0.000635 3.1e-05"
                 quat="0.507528 0.506268 0.491507 0.494499"
                 diaginertia="0.000807752 0.00055293 0.000468983"/>
    This is diagonal inertia for the (larger objects) FR_hip link, can be calculated from CAD files.
    For small objects, use point mass and ignore inertia tensor:
      <inertial mass="0.01" pos="0 0 0"/> for the foot link
      MUST DO for the trunk and all legs to get accurate dynamics.
    UPDATE based on actual mass of PLA servo motors and other components by referring to CAD files
    and real robot specs.

  - Adjust frame positions of Bodies
    Example:
      <body name="FR_hip" pos="0.12 -0.048 0">
      <body name="FR_thigh" pos="0 -0.05 0">
      <body name="FR_calf" pos="0 0 -0.1">
    Adjust these for all legs to make the model more accurate and closer to the real robot.

  - Adjust joint parameters to reflect the real robot's joint limits, damping, friction, etc.
    Example:
      <default class="abduction">
        <joint axis="1 0 0" damping="1" range="-0.802851 0.802851"/>
        <position ctrlrange="-0.802851 0.802851"/>
      </default>
      <default class="hip">
        <joint range="-1.0472 4.18879"/>
        <position ctrlrange="-1.0472 4.18879"/>
      </default>
      <default class="knee">
        <joint range="-2.69653 -0.916298"/>
        <position ctrlrange="-2.69653 -0.916298"/>
      </default>

  CAD Files Directory Structure:
  - STL: Original files from seniors
  - STL_combined: Simplified version using Blender
  - STP: Important for CAD software viewing. SPOTModell_v8.stp is the complete robot model
    (Useful for checking positions)

  Note: Ignore beztest.py

  SENSORS (simulation only — no physical sensors on hardware yet):
  - IMU (accelerometer + gyro) on trunk: provides orientation and angular velocity
    → Will be connected to ESP32 via I2C in Session 7
  - Foot force sensors on each calf: detect ground contact via normal force
    → Will be estimated from joint torques on real hardware (no FSR needed)
  - These sensors are used by the gait controller and state estimator in Sessions 3-6
    -->



<mujoco model="mini-spot">
  <compiler angle="radian" meshdir="CAD_Files/STL_combined" autolimits="true"/>

  <option cone="elliptic" impratio="100"/>

  <default>
    <default class="mini-spot">
      <geom friction="0.6" margin="0.001"/>
      <joint axis="0 1 0" damping="2" armature="0.01" frictionloss="0.2"/>
      <position kp="100" forcerange="-33.5 33.5"/>
      <default class="abduction">
        <!-- <joint axis="1 0 0" damping="1" range="-0.802851 0.802851"/> disabled for now-->
        <joint axis="1 0 0" damping="1" range="0 0"/>
        <position ctrlrange="-0.802851 0.802851"/>
      </default>
      <default class="hip">
        <!-- <joint range="-1.0472 4.18879"/>
        <position ctrlrange="-1.0472 4.18879"/> -->
        <joint range="-0.785 3.14"/>
        <position ctrlrange="-0.785 3.14"/>
      </default>
      <default class="knee">
        <joint range="-2.44 -0.916298"/>
        <position ctrlrange="-2.44 -0.916298"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="dark" />
      </default>
      <default class="collision">
        <geom group="3" type="capsule" rgba="0.8 0.2 0.2 0.2" density="1240"/>
        <default class="hip_left">
          <geom size="0.025 0.03 0.025" quat="1 1 0 0" type="box" pos="0 0 0"  mass = "0.200"/>
        </default>
        <default class="hip_right">
          <geom size="0.025 0.03 0.025" quat="1 1 0 0" type="box" pos="0 0 0"  mass="0.200"/>
        </default>
        <default class="thigh1">
          <geom size="0.010" fromto="0 0 0 0 0 -0.095"/>
        </default>
        <default class="thigh2">
          <geom size="0.015" fromto="0 0 0 -0.02 0 -0.1"/>
        </default>
        <default class="thigh3">
          <geom size="0.015" fromto="-0.02 0 -0.16 0 0 -0.2"/>
        </default>
        <default class="calf1">
          <geom size="0.015" fromto="0 0 0 0.02 0 -0.115"/>
        </default>
        <default class="calf2">
          <geom size="0.01" fromto="0.02 0 -0.13 0 0 -0.2"/>
        </default>
        <default class="foot">
          <geom type="sphere" size="0.018" pos="0.02 0 -0.12" priority="1" solimp="0.015 1 0.02" condim="6"
            friction="0.8 0.02 0.01"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="dark" specular="0" shininess="0.25" rgba="0.2 0.2 0.2 1"/>
    <material name="orange" specular="0" shininess="0.5" rgba="0.8 0.4 0.1 1"/>
    <mesh class="mini-spot" name = "calf" file="Leg_Left.stl" scale="1e-3 1e-3 1e-3"/>
    <mesh class="mini-spot" name = "hip" file="Hip_Left.stl" scale="1e-3 1e-3 1e-3"/>
    <mesh class="mini-spot" name = "thigh" file="Thigh_Left.stl" scale="1e-3 1e-3 1e-3"/>
    <mesh class="mini-spot" name = "thigh_mirror" file="Thigh_Right.stl" scale="1e-3 1e-3 1e-3"/>
    <mesh class="mini-spot" name = "trunk" file="Body_lowres.stl" scale="1e-3 1e-3 1e-3"/>
  </asset>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="trunk" pos="0 -1 2"/>
    <body name="trunk" pos="0 0 0.40" childclass="mini-spot">
      <freejoint/>

      <!-- ── IMU site at trunk center of mass ──────────────────────────────
           Simulation only. Provides accelerometer + gyro data to the
           gait controller and state estimator (Sessions 3-6).
           Will be wired to ESP32 via I2C in Session 7.
      ─────────────────────────────────────────────────────────────────── -->
      <site name="imu_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>

      <!-- <inertial mass="4.713" pos="0 0.0041 -0.0005"
        fullinertia="0.0158533 0.0377999 0.0456542 -3.66e-05 -6.11e-05 -2.75e-05"/> -->
      <geom class="visual" mesh="trunk" pos = "0 0.025 0" quat="1 0 0 0" material="orange"/>
      <geom class="collision" size="0.09 0.07 0.025" type="box"/>

      <!-- Point mass payload -->
      <!-- <body name="trunk_payload" pos="0 0 0">
        <inertial mass="0.4" pos="0 0 0" diaginertia="1e-5 1e-5 1e-5"/>
      </body> -->

      <!-- ════════════════════════════════════════════════════════════════
           FRONT RIGHT LEG
      ════════════════════════════════════════════════════════════════ -->
      <body name="FR_hip" pos="0.135 -0.060 0">
        <!-- <inertial mass="0.696" pos="-0.003311 -0.000635 3.1e-05" quat="0.507528 0.506268 0.491507 0.494499"
          diaginertia="0.000807752 0.00055293 0.000468983"/> -->
        <!-- <joint class="abduction" name="FR_hip_joint"/> -->
        <geom class="visual" mesh="hip" quat="0 1 0 0" material="orange" />
        <geom class="hip_right"/>
        <body name="FR_thigh" pos="0 -0.046 0">
          <!-- <inertial mass="1.013" pos="-0.003237 0.022327 -0.027326" quat="0.999125 -0.00256393 -0.0409531 -0.00806091"
            diaginertia="0.00555739 0.00513936 0.00133944"/> -->
          <joint class="hip" name="FR_thigh_joint"/>
          <geom class="visual" mesh="thigh_mirror" quat="0 0.3826834 0 0.9238795"/>
          <geom class="thigh1"/>
          <!-- <geom class="thigh2"/>
          <geom class="thigh3"/> -->
          <body name="FR_calf" pos="0 0.01 -0.1">
            <!-- <inertial mass="0.226" pos="0.00472659 0 -0.131975" quat="0.706886 0.017653 0.017653 0.706886"
              diaginertia="0.00340344 0.00339393 3.54834e-05"/> -->
            <joint class="knee" name="FR_calf_joint"/>
            <geom class="visual" mesh="calf" quat="0.65328148 0.65328148 -0.27059805 0.27059805"/>
            <geom class="calf1"/>
            <!-- <geom class="calf2"/> -->
            <geom class="foot"/>
            <!-- Foot contact site — matches foot geom position in calf frame -->
            <site name="FR_foot_site" pos="0.02 0 -0.12" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

      <!-- ════════════════════════════════════════════════════════════════
           FRONT LEFT LEG
      ════════════════════════════════════════════════════════════════ -->
      <body name="FL_hip" pos="0.135 0.060 0">
        <!-- <inertial mass="0.696" pos="-0.003311 0.000635 3.1e-05" quat="0.494499 0.491507 0.506268 0.507528"
          diaginertia="0.000807752 0.00055293 0.000468983"/> -->
        <!-- <joint class="abduction" name="FL_hip_joint"/> -->
        <geom class="visual" mesh="hip" material="orange"/>
        <geom class="hip_left"/>
        <body name="FL_thigh" pos="0 0.046 0">
          <!-- <inertial mass="1.013" pos="-0.003237 -0.022327 -0.027326" quat="0.999125 0.00256393 -0.0409531 0.00806091"
            diaginertia="0.00555739 0.00513936 0.00133944"/> -->
          <joint class="hip" name="FL_thigh_joint"/>
          <geom class="visual" mesh="thigh" quat="0 -0.3826834 0 0.9238795"/>
          <geom class="thigh1"/>
          <!-- <geom class="thigh2"/>
          <geom class="thigh3"/> -->
          <body name="FL_calf" pos="0 -0.01 -0.1">
            <!-- <inertial mass="0.226" pos="0.00472659 0 -0.131975" quat="0.706886 0.017653 0.017653 0.706886"
              diaginertia="0.00340344 0.00339393 3.54834e-05"/> -->
            <joint class="knee" name="FL_calf_joint"/>
            <geom class="visual" mesh="calf" quat="0.65328148 0.65328148 -0.27059805 0.27059805"/>
            <geom class="calf1"/>
            <!-- <geom class="calf2"/> -->
            <geom class="foot"/>
            <!-- Foot contact site — matches foot geom position in calf frame -->
            <site name="FL_foot_site" pos="0.02 0 -0.12" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

      <!-- ════════════════════════════════════════════════════════════════
           REAR RIGHT LEG
      ════════════════════════════════════════════════════════════════ -->
      <body name="RR_hip" pos="-0.135 -0.060 0">
        <!-- <inertial mass="0.696" pos="0.003311 -0.000635 3.1e-05" quat="0.491507 0.494499 0.507528 0.506268"
          diaginertia="0.000807752 0.00055293 0.000468983"/> -->
        <!-- <joint class="abduction" name="RR_hip_joint"/> -->
        <geom class="visual" quat="0 0 0 -1" mesh="hip" material="orange"/>
        <geom class="hip_right"/>
        <body name="RR_thigh" pos="0 -0.046 0">
          <!-- <inertial mass="1.013" pos="-0.003237 0.022327 -0.027326" quat="0.999125 -0.00256393 -0.0409531 -0.00806091"
            diaginertia="0.00555739 0.00513936 0.00133944"/> -->
          <joint class="hip" name="RR_thigh_joint"/>
          <geom class="visual" mesh="thigh_mirror" quat="0 0.3826834 0 0.9238795"/>
          <geom class="thigh1"/>
          <!-- <geom class="thigh2"/>
          <geom class="thigh3"/> -->
          <body name="RR_calf" pos="0 0.01 -0.1">
            <!-- <inertial mass="0.226" pos="0.00472659 0 -0.131975" quat="0.706886 0.017653 0.017653 0.706886"
              diaginertia="0.00340344 0.00339393 3.54834e-05"/> -->
            <joint class="knee" name="RR_calf_joint"/>
            <geom class="visual" mesh="calf" quat="0.65328148 0.65328148 -0.27059805 0.27059805"/>
            <geom class="calf1"/>
            <!-- <geom class="calf2"/> -->
            <geom class="foot"/>
            <!-- Foot contact site — matches foot geom position in calf frame -->
            <site name="RR_foot_site" pos="0.02 0 -0.12" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

      <!-- ════════════════════════════════════════════════════════════════
           REAR LEFT LEG
      ════════════════════════════════════════════════════════════════ -->
      <body name="RL_hip" pos="-0.13 0.060 0">
        <!-- <inertial mass="0.696" pos="0.003311 0.000635 3.1e-05" quat="0.506268 0.507528 0.494499 0.491507"
          diaginertia="0.000807752 0.00055293 0.000468983"/> -->
        <!-- <joint class="abduction" name="RL_hip_joint"/> -->
        <geom class="visual" quat="0 0 1 0" mesh="hip" material="orange"/>
        <geom class="hip_left"/>
        <body name="RL_thigh" pos="0 0.046 0">
          <!-- <inertial mass="1.013" pos="-0.003237 -0.022327 -0.027326" quat="0.999125 0.00256393 -0.0409531 0.00806091"
            diaginertia="0.00555739 0.00513936 0.00133944"/> -->
          <joint class="hip" name="RL_thigh_joint"/>
          <geom class="visual" mesh="thigh" quat="0 -0.3826834 0 0.9238795"/>
          <geom class="thigh1"/>
          <!-- <geom class="thigh2"/>
          <geom class="thigh3"/> -->
          <body name="RL_calf" pos="0 -0.01 -0.1">
            <!-- <inertial mass="0.226" pos="0.00472659 0 -0.131975" quat="0.706886 0.017653 0.017653 0.706886"
              diaginertia="0.00340344 0.00339393 3.54834e-05"/> -->
            <joint class="knee" name="RL_calf_joint"/>
            <geom class="visual" mesh="calf" quat="0.65328148 0.65328148 -0.27059805 0.27059805"/>
            <geom class="calf1"/>
            <!-- <geom class="calf2"/> -->
            <geom class="foot"/>
            <!-- Foot contact site — matches foot geom position in calf frame -->
            <site name="RL_foot_site" pos="0.02 0 -0.12" size="0.01" rgba="0 1 0 1"/>
          </body>
        </body>
      </body>

    </body>
  </worldbody>

  <actuator>
    <!-- HAA (abduction) joints are commented out — range locked to 0, not actuated -->
    <!-- <position class="abduction" name="FR_hip" joint="FR_hip_joint"/> -->
    <position class="hip"  name="FR_thigh" joint="FR_thigh_joint"/>
    <position class="knee" name="FR_calf"  joint="FR_calf_joint"/>
    <!-- <position class="abduction" name="FL_hip" joint="FL_hip_joint"/> -->
    <position class="hip"  name="FL_thigh" joint="FL_thigh_joint"/>
    <position class="knee" name="FL_calf"  joint="FL_calf_joint"/>
    <!-- <position class="abduction" name="RR_hip" joint="RR_hip_joint"/> -->
    <position class="hip"  name="RR_thigh" joint="RR_thigh_joint"/>
    <position class="knee" name="RR_calf"  joint="RR_calf_joint"/>
    <!-- <position class="abduction" name="RL_hip" joint="RL_hip_joint"/> -->
    <position class="hip"  name="RL_thigh" joint="RL_thigh_joint"/>
    <position class="knee" name="RL_calf"  joint="RL_calf_joint"/>
  </actuator>

  <!-- ── SENSORS ──────────────────────────────────────────────────────────────
       All simulation-only. No physical sensors on the robot yet.

       IMU (imu_site on trunk):
         - accelerometer: 3-axis linear acceleration in trunk body frame (m/s²)
         - gyro:          3-axis angular velocity in trunk body frame (rad/s)
         Used by: state estimator (Session 3), RL observation space (Session 8)

       Foot force sensors (XX_foot_site on each calf):
         - 3-axis contact force at the foot sphere location (N)
         - z-component > threshold → foot is on ground (contact detection)
         Used by: gait scheduler (Session 5), state estimator (Session 3)
         On real hardware: will be estimated from joint torques, no FSR needed.
  ─────────────────────────────────────────────────────────────────────────── -->
  <sensor>
    <!-- IMU — trunk orientation and angular velocity -->
    <accelerometer name="imu_accel" site="imu_site"/>
    <gyro          name="imu_gyro"  site="imu_site"/>

    <!-- Foot contact forces — one per leg, 3-axis (N) -->
    <force name="FR_foot_force" site="FR_foot_site"/>
    <force name="FL_foot_force" site="FL_foot_site"/>
    <force name="RR_foot_force" site="RR_foot_site"/>
    <force name="RL_foot_force" site="RL_foot_site"/>
  </sensor>

  <keyframe>
    <key name="home"  ctrl="3.14 -2.17 3.14 -2.17 3.14 -2.17 3.14 -2.17"/>
    <key name="start" ctrl="0.687 0 0.687 0 0.687 0 0.687 0"/>
  </keyframe>

</mujoco>
